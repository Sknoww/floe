# Binary produced by `go build` in the repo root.
/floe

# GoReleaser build output.
/dist

# The frontend's build output, embedded in the binary. The placeholder keeps
# `go build` working before the first frontend build.
/web/dist/*
!/web/dist/.gitkeep

# The frontend's dependencies. package-lock.json is committed: the release
# build installs from it with `npm ci`.
/web/node_modules/

# The assembled design canvas, rebuilt from the .dc.html sources beside it.
/design/mockups/floe-mockups.html
